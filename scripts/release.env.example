# EVraahein — release build environment (template)
#
# Copy to scripts/release.env (gitignored), adjust if needed, then:
#   set -a && source scripts/release.env && set +a
#   scripts/build_android_release.sh                 # APK (default)
#   BUILD_FORMAT=appbundle scripts/build_android_release.sh   # .aab for Play Store
#
# The BACKEND_URL / SUPABASE values below are the current live production
# values (verified 2026-10-28):
#   - ev-router-backend-41342649973.us-central1.run.app ... /ready -> 200, fully configured
#   - mzxwbfpxmyjmbfhosgkk.supabase.co ................... live (auth/v1/health -> 401 as expected)
# The old asia-south1 backend (evraahein-backend-187759131948) is deprecated;
# do NOT point releases at it.

# ---- Backend API (current production, us-central1) ----
export BACKEND_URL="https://ev-router-backend-41342649973.us-central1.run.app"

# ---- Supabase (client SDK) ----
# Must be the SAME project the backend uses. The anon key is a public client
# key (it ships inside the APK) — not a secret. Never put the service_role key here.
export SUPABASE_URL="https://mzxwbfpxmyjmbfhosgkk.supabase.co"
export SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im16eHdiZnB4bXlqbWJmaG9zZ2trIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjQ1NTY0NjIsImV4cCI6MjA4MDEzMjQ2Mn0.dX-ZkKDOgXfOeyYrkyA77NLZmM-sWyf2zjXfVp7zFWg"

# ---- Feature flags ----
export SOS_ENABLED=true            # shows SOS in the mobile app
export FEATURE_SOS_ENABLED=true    # must also be set on the Cloud Run backend

# ---- Optional: production observability ----
# Set a real DSN to enable crash reporting in the release build. The build
# script forwards this to the app only when it is non-empty.
export SENTRY_DSN=""

# ---- Optional: AdMob (leave unset to ship with ads OFF) ----
# Ads only turn on in release when ADS_ENABLED=true AND the banner id is set.
# export ADS_ENABLED=true
# export ADMOB_BANNER_ANDROID=""   # ca-app-pub-XXXX/YYYY
# export ADMOB_BANNER_IOS=""       # ca-app-pub-XXXX/YYYY

# =========================================================================
# CRITICAL — server side, not set here:
# The deployed Cloud Run backend must have SUPABASE_URL / SUPABASE_KEY /
# SUPABASE_SERVICE_ROLE_KEY pointing at the LIVE project above. Verify with:
#   scripts/check_backend.sh   # /ready must return 200
# =========================================================================
