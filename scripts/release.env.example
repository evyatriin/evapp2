# EVraahein — release build environment (template)
#
# Copy to scripts/release.env (gitignored), fill in the blanks, then:
#   set -a && source scripts/release.env && set +a
#   scripts/build_android_release.sh          # builds the APK/AAB with these values
#
# WHY THIS EXISTS: the BACKEND_URL and Supabase values previously used are dead.
# As of 2026-08-01 verified from outside:
#   - evyatri-backend-1034578691498.run.app ....... DELETED (404)
#   - ev-ranger-backend-1086098773353.run.app ..... DELETED (404)
#   - bqbiysdnqtcnckybzffk.supabase.co ............ DELETED (NXDOMAIN)
#   - mzxwbfpxmyjmbfhosgkk.supabase.co ............ DELETED (NXDOMAIN)
# Only the backend below is live — but its own database is currently DOWN
# (/ready -> 503 "Database is unavailable"). Provision/restore Supabase first.

# ---- Backend API (VERIFIED LIVE 2026-08-01: /health -> {"status":"ok"}) ----
export BACKEND_URL="https://evraahein-backend-187759131948.asia-south1.run.app"

# ---- Supabase (client SDK) — MUST be a LIVE project. Fill these in. ----
# Get from Supabase dashboard > Project Settings > API.
# This MUST be the same project the deployed backend uses (see note below).
export SUPABASE_URL=""            # e.g. https://<project-ref>.supabase.co
export SUPABASE_ANON_KEY=""       # the "anon"/publishable key (NOT service_role)

# ---- Feature flags ----
export SOS_ENABLED=true            # shows SOS in the mobile app
export FEATURE_SOS_ENABLED=true    # must also be set on Cloud Run backend

# ---- Optional: production observability & ads (recommended for launch) ----
export SENTRY_DSN=""              # enables crash reporting in release builds
# export ADS_ENABLED=true        # only if you want AdMob live at launch

# =========================================================================
# CRITICAL — server side, not set here:
# The deployed Cloud Run backend must have SUPABASE_URL / SUPABASE_KEY /
# SUPABASE_SERVICE_ROLE_KEY pointing at a LIVE project, or the DB stays down
# and login/routes/chargers/community all fail. Update the Cloud Run service
# env vars (see scripts/deploy_cloud_run.sh) and redeploy. Verify with:
#   scripts/check_backend.sh   # /ready must return 200
# =========================================================================
